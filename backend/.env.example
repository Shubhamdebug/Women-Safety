# Copy these to your terminal / environment if you want to change defaults.
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///safeher.db

# OPTIONAL: real SMS through Twilio. Leave empty to run in SIMULATED mode
# (alerts are printed in the terminal and saved in the alert_logs table).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
