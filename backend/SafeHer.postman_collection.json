{
  "info": {
    "name": "SafeHer Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order: Health -> Register -> Add guardian -> Create SOS -> ... Admin requests need the admin created with seed_admin.py (phone 9999999999 / admin123)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "sosId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha\",\n  \"phone\": \"9876543210\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('token', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('token', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Guardians",
      "item": [
        {
          "name": "Add guardian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guardians",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guardians"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mom\",\n  \"phone\": \"9822222222\",\n  \"relation\": \"mother\"\n}"
            }
          }
        },
        {
          "name": "List guardians",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guardians",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guardians"
              ]
            }
          }
        },
        {
          "name": "Delete guardian 1",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guardians/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guardians",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. SOS",
      "item": [
        {
          "name": "Create SOS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{$guid}}\",\n  \"latitude\": 16.7,\n  \"longitude\": 74.24,\n  \"battery_level\": 14,\n  \"trigger\": \"shake\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('sosId', d.incident.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add location ping",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sos/{{sosId}}/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sos",
                "{{sosId}}",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 16.701,\n  \"longitude\": 74.241\n}"
            }
          }
        },
        {
          "name": "Upload photo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sos/{{sosId}}/photo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sos",
                "{{sosId}}",
                "photo"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Get SOS details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sos/{{sosId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sos",
                "{{sosId}}"
              ]
            }
          }
        },
        {
          "name": "My SOS list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sos/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sos",
                "mine"
              ]
            }
          }
        },
        {
          "name": "Resolve (safe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sos/{{sosId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sos",
                "{{sosId}}",
                "resolve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Anonymous reports (no login)",
      "item": [
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Create report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"poor_lighting\",\n  \"description\": \"Street light not working near library gate\",\n  \"latitude\": 16.7001,\n  \"longitude\": 74.2401\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin (dashboard)",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Live incidents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/incidents?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "incidents?limit=50"
              ]
            }
          }
        },
        {
          "name": "Only active SOS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/incidents?kind=sos&status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "incidents?kind=sos&status=active"
              ]
            }
          }
        },
        {
          "name": "Hotspots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/hotspots?days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "hotspots?days=30"
              ]
            }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "stats"
              ]
            }
          }
        }
      ]
    }
  ]
}